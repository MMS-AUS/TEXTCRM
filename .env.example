# Copy to .env and fill in. Names only — real values live in .env (gitignored) and Bitwarden.
# Source: claude_code_CRM_SECRETS.md §2.3

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000
TOKEN_ENCRYPTION_KEY=            # 32 random bytes, base64 — encrypts stored OAuth tokens
ALLOWED_EMAIL_DOMAIN=makemysolar.com.au

# --- Database (local Docker Postgres — see docker-compose.yml) ---
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
DATABASE_URL_TEST=postgres://crm:crm@localhost:5432/crm_test

# --- Firebase Auth ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=   # path to JSON outside the repo

# --- Google (Sheets service account, Gmail OAuth) ---
GOOGLE_SERVICE_ACCOUNT_PATH=
SHEETS_SYNC_INTERVAL_MINUTES=5
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=

# --- File storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- MessageMedia ---
MESSAGEMEDIA_API_KEY=
MESSAGEMEDIA_API_SECRET=
MESSAGEMEDIA_DEFAULT_SENDER=
MESSAGEMEDIA_WEBHOOK_SECRET=

# --- VoIPLine ---
VOIPLINE_API_BASE=https://api.voipline.net.au/v1
VOIPLINE_API_KEY=
VOIPLINE_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API) ---
META_APP_ID=
META_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- OpenSolar ---
OPENSOLAR_API_BASE=https://api.opensolar.com
OPENSOLAR_ORG_ID=
OPENSOLAR_API_TOKEN=
OPENSOLAR_WEBHOOK_SECRET=

# --- BridgeSelect ---
BRIDGESELECT_API_BASE=https://api.bridgeselect.com.au
BRIDGESELECT_ACCOUNT_KEY=
BRIDGESELECT_ACCOUNT_SALT=

# --- Xero ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
