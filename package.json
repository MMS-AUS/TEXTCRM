{
  "name": "mmscrm",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,worker,web --prefix-colors blue,yellow,magenta \"npm run dev -w @mms/api\" \"npm run dev:worker -w @mms/api\" \"npm run dev -w @mms/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @mms/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @mms/api",
    "db:migrate": "npm run db:migrate -w @mms/api",
    "db:studio": "npm run db:studio -w @mms/api",
    "db:reset": "npm run db:reset -w @mms/api",
    "db:seed": "npm run db:seed -w @mms/api",
    "db:fake-leads": "npm run db:fake-leads -w @mms/api --",
    "user:create": "npm run user:create -w @mms/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
